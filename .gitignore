# python
.venv/
__pycache__/
*.pyc
*.pyo

# node
node_modules/
client/dist/

# logs
*.log

# archive
archive/

# local secrets & dev TLS certs (never commit)
*.pem
.env.local
.env

# docker: runtime state volume + generated TLS certs
server/data/
certs/
dist/

# server runtime state (recreated automatically)
rooms.json
server/rooms.json
server/archive/*
!server/archive/.gitkeep
# per-class glossary SQLite db (dev runs; docker keeps it in server/data/)
server/app.db
server/app.db-shm
server/app.db-wal

# large local audio (demo data + generated cache, not shipped)
server/class.mp3
server/class_16k.wav
*.mp3
