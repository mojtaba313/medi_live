# Text-correction (stage 2) configuration for server/server.py
# Copy to .env or export in the shell before running server.py.

# Backend: auto | local | openai | ollama | off
#  auto   = use OPENAI_API_KEY if set, else instant local Persian normalizer
#  local  = only the built-in normalizer (zero latency, no key, weak-system safe)
#  openai = OpenAI-compatible chat API (OpenAI / OpenRouter / DeepSeek / vLLM ...)
#  ollama = local Ollama text model (e.g. qwen2.5:1.5b), falls back to local
#  off    = disable corrections, raw ASR text only
CORRECTOR_BACKEND=auto

# --- OpenAI-compatible API (when CORRECTOR_BACKEND=openai, or auto+key) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama (when CORRECTOR_BACKEND=ollama) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# --- Chunking: raw segments are buffered then corrected as one chunk ---
# Correct when buffer >= MAX, or (>= MIN and sentence-end/timeout), or session end.
# CORRECT_MIN_CHARS=60
# CORRECT_MAX_CHARS=400
# CORRECT_TIMEOUT_S=8.0
# LLM_TIMEOUT_S=30.0

# --- Decode batching (raw latency): mic audio is accumulated into blocks so each
# accept+decode forward pass runs once per block. Smaller = livelier partials but
# more overhead; below ~0.25s the pipeline runs slower than realtime on weak CPUs.
# DECODE_BLOCK_S=0.5
# DECODE_FLUSH_S=0.25

# --- Admin + rooms/archive (new) ---
# Token required in the web Admin panel (header X-Admin-Token) for:
# creating rooms, granting/revoking recording permission, kick/clear.
# ADMIN_TOKEN=admin123
# LOG_LEVEL=INFO
