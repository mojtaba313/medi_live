# Copy to .env next to docker-compose.yml, then edit. Compose reads it
# automatically; no `export` needed, no dotenv package required.

# --- REQUIRED: admin panel login token (header X-Admin-Token) ---
# The default below is the server's built-in fallback. CHANGE IT.
ADMIN_TOKEN=change-me-please

# --- REQUIRED for phone access: this machine's LAN IP ---
# Phones reach the app over https://<this-ip>:8443, and the auto-generated
# certificate must list that address or the browser shows a name mismatch on
# every page. Find your IP with:  hostname -I
# Example (laptop on wifi, hotspot, or office LAN):
TLS_SAN=192.168.1.50

# --- Published HTTPS port ---
PORT=8443

# --- Text correction backend ---
# local  = built-in Persian normalizer + per-class glossary. No key, no
#          internet, instant. Recommended as the baseline.
# ollama = also run a local LLM (set OLLAMA_URL below) for better wording.
# auto   = use an OpenAI-compatible API if OPENAI_API_KEY is provided.
# off    = raw ASR text only.
CORRECTOR_BACKEND=local

# To use a local LLM (run Ollama on the HOST; host.docker.internal reaches it
# from inside the container):
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# --- Decode batching: raw-text latency vs. CPU load ---
# Smaller DECODE_BLOCK_S = livelier partial captions but more overhead; below
# ~0.25s the pipeline can fall behind realtime on a weak CPU.
DECODE_BLOCK_S=0.5
DECODE_FLUSH_S=0.25

# --- Logging ---
LOG_LEVEL=INFO